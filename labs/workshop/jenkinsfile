pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials') // Securely access stored DockerHub credentials
        REPO_NAME = 'orbiton3005/python-fake-data-app' // DockerHub repository name
        GITHUB_REPO = 'https://github.com/or3005/devopshift-welcome.git' // Update with your GitHub repository URL
        GITHUB_BRANCH = 'oragin' // Ensure this matches your actual branch name
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: "${GITHUB_BRANCH}", url: "${GITHUB_REPO}"
            }
        }

        stage('Install Dependencies') {
            agent {
                docker {
                    image 'python:3.8' // Use any Python version for dependency installation
                    args '-v $HOME/.cache/pip:/root/.cache/pip'
                }
            }
            steps {
                sh 'pip install faker'
            }
        }

        stage('Test Application') {
            matrix {
                axes {
                    axis {
                        name 'PYTHON_VERSION'
                        values ['3.8', '3.9'] // Directly define the versions as a list of strings
                    }
                }
                stages {
                    stage('Run Test') {
                        agent {
                            docker {
                                image "python:${PYTHON_VERSION}"
                                reuseNode true
                            }
                        }
                        steps {
                            sh 'python app.py'
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            matrix {
                axes {
                    axis {
                        name 'PYTHON_VERSION'
                        values ['3.8', '3.9'] // Directly define the versions as a list of strings
                    }
                }
                stages {
                    stage('Build Image') {
                        steps {
                            script {
                                sh "docker build --build-arg PYTHON_VERSION=${PYTHON_VERSION} -t ${REPO_NAME}:${PYTHON_VERSION} ."
                            }
                        }
                    }
                }
            }
        }

        stage('Push to DockerHub') {
            matrix {
                axes {
                    axis {
                        name 'PYTHON_VERSION'
                        values ['3.8', '3.9'] // Directly define the versions as a list of strings
                    }
                }
                stages {
                    stage('Push Image') {
                        steps {
                            script {
                                withDockerRegistry([credentialsId: 'dockerhub-credentials', url: 'https://index.docker.io/v1/']) {
                                    sh "docker push ${REPO_NAME}:${PYTHON_VERSION}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            sh "docker logout" // Ensures security by logging out of DockerHub
            echo "✅ Pipeline execution completed."
        }
    }
}
